цоллерн": "Hohenzollern", "Носке": "Noske", "Больц": "Bolz", "Мараун": "Mahraun", "Хельпах": "Hellpach", "Боймер": "Baumer", "Яррес": "Jarres", "Тельман": "Thalmann", "Мюнценберг": "Munzenberg", "Брюнинг": "Bruning", "Лаутенбах": "Lautenbach", "Пусто": "Empty", "Познакомиться с новым канцлером": "Become acquainted with the new chancellor", "Убедить Гинденбурга продолжать поддерживать Папена": "Convince Hindenburg to continue supporting Papen", "Дружить со Шлейхером": "Be buddies with Schleicher", "Плести интриги против Шлейхера": "Scheme against Schleicher", "Поддерживать нового канцлера": "Support the new chancellor", "Сокрушаться о потерянном": "Cry over spilt milk", "Заручиться поддержкой нацистов для своего кабинета": "Nazi backing for his cabinet", "Править в президентском правительстве": "Rule in a presidential government", "Укрепить власть": "Consolidate power", "Контролировать Папена со стороны": "Control Papen from the sidelines", "Вернуть доверие общества": "Regain public confidence", "Искать поддержку в рейхстаге": "Scavenge for parliamentary backing", "гуманитарная": "humanist", "демократическая": "democratic", "научная": "scientific", "профессиональная": "vocational", "традиционная": "traditional", "Либерал": "Liberal", "Консерватор": "Conservative", "Центрист": "Centrist"};
function candkey(n) { return cand_ascii[n] || n; }
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
    if (party == "nsdap" && Q.nsdap_split) {
        Q.nsdap_hitler_support = Q.rural_nsdap_normalized*Q.rural;
        Q.nsdap_hitler_support += Q.old_middle_nsdap_normalized*Q.old_middle;
        Q.nsdap_hitler_support += Q.catholics_nsdap_normalized*Q.catholics;

        if (Q.dsu_exist && !Q.nvf_exist) {
            Q.dsu_support = Q.workers_nsdap*Q.workers*((120 - Q.sa_force) / 100);
            Q.dsu_support += Q.unemployed_nsdap*Q.effective_unemployed*((80 - Q.sa_force) / 100);
            Q.dsu_support += Q.new_middle_nsdap*Q.new_middle;
        } else if (!Q.dsu_exist && Q.nvf_exist) {
            Q.nvf_support = Q.unemployed_nsdap*Q.effective_unemployed*((120 - Q.sa_force) / 100);
            Q.nvf_support += Q.workers_nsdap*Q.workers*((Q.sa_force - 80) / 100);
            Q.nvf_support += Q.new_middle_nsdap*Q.new_middle;
        } else if (Q.dsu_exist && Q.nvf_exist) {
            Q.dsu_support = Q.workers_nsdap*Q.workers*((120 - Q.sa_force) / 100);
            Q.dsu_support += Q.unemployed_nsdap*Q.effective_unemployed*((80 - Q.sa_force) / 100);
            Q.dsu_support += Q.new_middle_nsdap*Q.new_middle;

            Q.nvf_support = Q.unemployed_nsdap*Q.effective_unemployed*((120 - Q.sa_force) / 100);
            Q.nvf_support += Q.workers_nsdap*Q.workers*((Q.sa_force - 80) / 100);
        } else {
            Q.nsdap_hitler_support += Q.workers_nsdap*Q.workers;
            Q.nsdap_hitler_support += Q.unemployed_nsdap*Q.unemployed;
            Q.nsdap_hitler_support += Q.new_middle_nsdap*Q.new_middle;
        }
    }
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    if (party == "nsdap" && Q.nsdap_split) {
        Q.nsdap_hitler_normalized = Q.nsdap_hitler_support / total_support;
        Q.dsu_normalized = Q.dsu_support / total_support;
        Q.nvf_normalized = Q.nvf_support / total_support;
        Q.nsdap_hitler_votes = Math.round(Q.nsdap_hitler_normalized*1000) / 10;
        Q.dsu_votes = Math.round(Q.dsu_normalized*1000) / 10;
        Q.nvf_votes = Math.round(Q.nvf_normalized*1000) / 10;
    }
    Q[candkey(party) + '_votes'] = Math.round(Q[party+'_normalized']*1000)/ 10;
}

Q.round = 0;
Q.hindenburg_dead = 1;
Q.president = "Бумке (и.о.)";
if (Q.judicial_reform >= 4) Q.president = "Гроссман (и.о.)"

Q.Heuss_votes_pre = 0;

Q.dnef_candidate = "Хаммерштейн";
Q.spd_candidate = "Шумахер";
Q.kpd_candidate = Q.spd_candidate;
Q.z_candidate = "Аденауэр";
if (Q.z_leader == "Брахт") Q.z_candidate = Q.dnef_candidate;
Q.ddp_candidate = "Хойс";
Q.lvp_candidate = "Хойс";
Q.dvp_candidate = "Хойс";
if (Q.dstp_dnef) Q.ddp_candidate = Q.dnef_candidate;
if (Q.lvp_dnef) Q.lvp_candidate = Q.dnef_candidate;
if (Q.dvp_dnef) Q.dvp_candidate = Q.dnef_candidate;
Q.heuss_run = 1;
if (Q.ddp_candidate == "Хойс") Q.Heuss_votes_pre += Q.ddp_votes;
if (Q.lvp_candidate == "Хойс") Q.Heuss_votes_pre += Q.lvp_votes;
if (Q.dvp_candidate == "Хойс") Q.Heuss_votes_pre += Q.dvp_votes;
if (Q.Heuss_votes_pre < 8) {
    if (Q.z_candidate != Q.dnef_candidate) Q.ddp_candidate = Q.z_candidate;
    if (Q.z_candidate != Q.dnef_candidate) Q.lvp_candidate = Q.z_candidate;
    if (Q.z_candidate != Q.dnef_candidate) Q.dvp_candidate = Q.z_candidate;
    if (Q.z_candidate == Q.dnef_candidate) Q.ddp_candidate = Q.dnef_candidate;
    if (Q.z_candidate == Q.dnef_candidate) Q.lvp_candidate = Q.dnef_candidate;
    if (Q.z_candidate == Q.dnef_candidate) Q.dvp_candidate = Q.dnef_candidate;
    if (Q.dstp_dnef) Q.ddp_candidate = Q.dnef_candidate;
    if (Q.lvp_dnef) Q.lvp_candidate = Q.dnef_candidate;
    if (Q.dvp_dnef) Q.dvp_candidate = Q.dnef_candidate;
    Q.heuss_run = 0;
}
Q.nsdap_candidate = "Геринг";
Q.nsdap_hitler_candidate = "Геринг";
if (Q.dsu_leader != "Отто Штрассер") Q.dsu_candidate = "Фрик";
if (Q.dsu_leader == "Отто Штрассер") Q.dsu_candidate = "Штрассер";
Q.nvf_candidate = "Бойкот";
if (Q.nvf_dnef) Q.nvf_candidate = "Хаммерштейн";
Q.dnvp_candidate = "Хаммерштейн";
Q.other_candidate = "Хаммерштейн";
Q.is_unity_candidate = 0;
Q.sapd_candidate = Q.kpd_candidate;
Q.kvp_candidate = Q.dnvp_candidate;
Q.dnf_candidate = Q.dnvp_candidate;
!}
