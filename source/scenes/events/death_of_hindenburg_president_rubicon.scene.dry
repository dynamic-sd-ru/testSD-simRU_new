var cand_ascii = {"Геринг": "Goring", "Аденауэр": "Adenauer", "Хойс": "Heuss", "Шумахер": "Schumacher", "СДПГ": "SPD", "Браун": "Braun", "Брайтшайд": "Breitscheid", "Розенфельд": "Rosenfeld", "Радикалы": "Radical", "Левые": "Left", "Центр": "Center", "Труд": "Labor", "Реформисты": "Reformists", "Неоревизионисты": "Neorevisionists", "Хаммерштейн": "Hammerstein", "Гергт": "Hergt", "Осецкий": "Ossietzky", "Манн": "Mann", "Примиренцы": "Conciliators", "Гитлер": "Hitler", "Правые": "Right", "Зельдте": "Seldte", "Гинденбург": "Hindenburg", "Папен": "Papen", "КПГ": "KPD", "Гёрделер": "Goerdeler", "Вирт": "Wirth", "Умеренные": "Moderate", "Дитрих": "Dietrich", "Дингельдей": "Dingeldey", "Тревиранус": "Treviranus", "Ламбах": "Lambach", "Шиле": "Schiele", "Вестарп": "Westarp", "ННП": "DVP", "Вельс": "Wels", "Маркс": "Marx", "Штегервальд": "Stegerwald", "Каас": "Kaas", "Йоос": "Joos", "ХНП": "CVP", "Шольц": "Scholz", "НННП": "DNVP", "Гереке": "Gereke", "Лежён-Юнг": "Lejeune-Jung", "Леттов_Форбек": "Lettow-Vorbeck", "Леммер": "Lemmer", "Майер": "Maier", "Штольпер": "Stolper", "НДП": "NPD", "НГП": "DStP", "Франц Зельдте": "Franz Seldte", "Гесслер": "Gessler", "Эккенер": "Eckener", "Теодор Хойс": "Theodor Heuss", "Пауль фон Леттов_Форбек": "Paul von Lettow_Vorbeck", "Гугенберг": "Hugenberg", "Оскар Гергт": "Oskar Hergt", "Брахт": "Bracht", "Отто Штрассер": "Otto Strasser", "Фрик": "Frick", "Штрассер": "Strasser", "Бойкот": "Boycott", "Штреземан": "Stresemann", "Курциус": "Curtius", "Шлейхер": "Schleicher", "Глацель": "Glatzel", "Раумер": "Raumer", "Хуго": "Hugo", "Патерналистский консерватизм": "Paternalistic Conservatism", "фон Раумер": "von-Raumer", "Либеральный консерватизм": "Liberal Conservatism", "Национал-консерватизм": "National Conservatism", "Триумвират": "Triumvirate", "Койдель": "Keudell", "Лютер": "Luther", "Тиль": "Thiel", "Кардорф": "Kardorff", "цу Дона-Шлодин": "zu Dohna-Schlodien", "ЛНП": "LVP", "ФНЕГ": "DNEF", "НСС": "DSU", "НСДАП": "NSDAP", "Лебер": "Leber", "Виссель": "Wissell", "Зеверинг": "Severing", "Гильфердинг": "Hilferding", "Мольденхауэр": "Moldenhauer", "Райнхольд": "Reinhold", "Шмидт": "Schmidt", "Тренделенбург": "Trendelenburg", "Радбрух": "Radbruch", "Кох-Везер": "Koch-Weser", "Притвиц": "Prittwitz", "Бааде": "Baade", "Гермес": "Hermes", "Грёнер": "Groener", "Гржезинский": "Grzesinski", "Юхач": "Juchacz", "Кайзер": "Kaiser", "Зект": "Seeckt", "Хельдт": "Heldt", "Дикман": "Dieckmann", "Остер": "Oster", "Выступать за назначение Папена канцлером": "Advocate for a Papen chancellorship", "Добиваться собственного переназначения": "Push for his own reappointment", "Примирить Шлейхера и Гинденбурга": "Reconcile Schleicher and Hindenburg", "Выступать за назначение Гитлера канцлером": "Advocate for a Hitler chancellorship", "Геббельс": "Goebbels", "Поддерживать общественный порядок": "Maintain public order", "Отложить выборы на неопределенный срок": "Postpone elections indefinitely", "Пауль фон Гинденбург": "Paul von Hindenburg", "Дюстерберг": "Duesterberg", "Признать поражение": "Concede defeat", "Эйнштейн": "Einstein", "антидемократические партии": "anti-democratic parties", "крайне правых": "far right", "буржуазные партии": "bourgeois parties", "левую": "left", "центристскую": "centrist", "тред-юнионистскую": "labor", "Адольф Гитлер": "Adolf Hitler", "Вильгельм Фрик": "Wilhelm Frick", "Альфред Гугенберг": "Alfred Hugenberg", "Теодор Дюстерберг": "Theodor Duesterberg", "Отто Браун": "Otto Braun", "Курт Розенфельд": "Kurt Rosenfeld", "Гуго Эккенер": "Hugo Eckener", "Конрад Аденауэр": "Konrad Adenauer", "Отто Гесслер": "Otto Gessler", "Юлиус Курциус": "Julius Curtius", "Герман Дитрих": "Hermann Dietrich", "Эдуард Дингельдей": "Eduard Dingeldey", "Пауль фон Леттов-Форбек": "Paul von Lettow-Vorbeck", "Карл Яррес": "Karl Jarres", "Ганс Лютер": "Hans Luther", "Адам Штегервальд": "Adam Stegerwald", "Куно фон Вестарп": "Kuno von Westarp", "Немецкая демократическая партия": "German Democratic Party", "Бредов": "Bredow", "Гогенцоллерн": "Hohenzollern", "Носке": "Noske", "Больц": "Bolz", "Мараун": "Mahraun", "Хельпах": "Hellpach", "Боймер": "Baumer", "Яррес": "Jarres", "Тельман": "Thalmann", "Мюнценберг": "Munzenberg", "Брюнинг": "Bruning", "Лаутенбах": "Lautenbach", "Пусто": "Empty", "Познакомиться с новым канцлером": "Become acquainted with the new chancellor", "Убедить Гинденбурга продолжать поддерживать Папена": "Convince Hindenburg to continue supporting Papen", "Дружить со Шлейхером": "Be buddies with Schleicher", "Плести интриги против Шлейхера": "Scheme against Schleicher", "Поддерживать нового канцлера": "Support the new chancellor", "Сокрушаться о потерянном": "Cry over spilt milk", "Заручиться поддержкой нацистов для своего кабинета": "Nazi backing for his cabinet", "Править в президентском правительстве": "Rule in a presidential government", "Укрепить власть": "Consolidate power", "Контролировать Папена со стороны": "Control Papen from the sidelines", "Вернуть доверие общества": "Regain public confidence", "Искать поддержку в рейхстаге": "Scavenge for parliamentary backing", "гуманитарная": "humanist", "демократическая": "democratic", "научная": "scientific", "профессиональная": "vocational", "традиционная": "traditional", "Либерал": "Liberal", "Консерватор": "Conservative", "Центрист": "Centrist"};
function candkey(n) { return cand_ascii[n] || n; }
var candidate_descs = {
  Strasser: "Otto Strasser of the <span style='color: #6A1E1E; font-weight: bold;'>DSU</span>",
  Frick: "Wilhelm Frick of the <span style='color: #6A1E1E; font-weight: bold;'>DSU</span>",
  Геринг: "Герман Геринг от <span style='color: #7A3C00; font-weight: bold;'>НСДАП</span>",
  Hammerstein: "Kurt von Hammerstein-Equord of the <span style='color: #BFC8CC; font-weight: bold;'>DNEF</span>",
  Аденауэр: "Konrad Adenauer of the <span style='color: #000000; font-weight: bold;'>Center Party</span>",
  Хойс: "Теодор Хойс от <span style='color: #D3C24D; font-weight: bold;'>НДП</span>",
  Шумахер: "Курт Шумахер от <span style='color: #c00000; font-weight: bold;'>СДПГ</span>"
};

if (Q.dstp_formed) {
    candidate_descs.Хойс = "Теодор Хойс of the <span style='color: #D3C24D; font-weight: bold;'>DStP</span>";
}
if (Q.lvp_formed) {
    candidate_descs.Хойс = "Теодор Хойс от <span style='color: #FFCC00; font-weight: bold;'>ЛНП</span>";
}
if (Q.z_party_name == "ХНП") {
    candidate_descs.Аденауэр = "Конрад Аденауэр от <span style='color: #000000; font-weight: bold;'>ХНП</span>";
}
for (var k in candidate_descs) {
    Q[candkey(k) + '_running'] = 0;
}
var candidate_votes = {};
Q.parties_election = Q.parties;
if (Q.dsu_exist) {
    Q.parties_election.push('nsdap_hitler');
    Q.parties_election.push('dsu');
    Q.nsdap_normalized = 0;
}
if (Q.nvf_exist) {
    Q.parties_election.push('nvf');
    Q.nsdap_normalized -= Q.nvf_normalized;
    Q.nsdap_normalized = 0;
}
if (Q.center_bvp_votes) {
    Q.bvp_normalized = Q.bvp_votes / 100;
    Q.z_normalized -= Q.bvp_normalized;
    Q.parties_election.push('bvp')
    Q.bvp_candidate = Q.dnef_candidate;
}
for (var party of Q.parties_election) {
    var supported_candidate = Q[party + '_candidate'];
    supported_candidate = supported_candidate.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    Q[candkey(supported_candidate) + '_running'] = 1;
    if (supported_candidate in candidate_votes) {
        candidate_votes[supported_candidate] += Q[party + '_normalized'];
    } else {
        candidate_votes[supported_candidate] = Q[party + '_normalized'];
    }
}
var total_votes = 0;
Q.winner = "";  
Q.winner_votes = 0;
Q.has_majority = 0;
for (var k in candidate_votes) {
    total_votes += candidate_votes[k];
    if (candidate_votes[k] > Q.winner_votes) {
        Q.winner = k;
        Q.winner_votes = candidate_votes[k];
    }
    if (candidate_votes[k] >= 0.5) {
        Q.has_majority = 1;
    }
}
for (var k in candidate_votes) {
    Q[candkey(k) + '_votes'] = Math.round(1000*candidate_votes[k]/total_votes)/10;
    Q[candkey(k) + '_votes_disp'] = Q[candkey(k) + '_votes'].toFixed(1);
}
Q.winner_votes = Math.round(1000*Q.winner_votes/total_votes)/10;
Q.winner_votes_disp = Q.winner_votes.toFixed(1);
Q.winner_desc = candidate_descs[Q.winner];

Q.round += 1

if (Q.spd_candidate == "Бойкот" || Q.sapd_candidate == "Бойкот" || Q.kpd_candidate == "Бойкот") {
    Q.boycott_votes = 0;
    if (Q.kpd_candidate == "Бойкот") Q.boycott_votes += Q.kpd_votes;
    if (Q.sapd_candidate == "Бойкот") Q.boycott_votes += Q.sapd_votes;
    if (Q.spd_candidate == "Бойкот") Q.boycott_votes += Q.spd_votes;
}
!}
go-to: r2_start if round = 1 and not has_majority; election_end if round > 1; r1_winner if has_majority

Результаты выборов:

