@r2_start
on-arrival: {!
Q.adenauer_drops_out = 0;
Q.gessler_drops_out = 0;
if (Q.z_candidate == "Аденауэр" && (Q.ddp_candidate == "Гесслер" && !Q.lvp_formed || Q.dvp_candidate == "Гесслер" && !Q.lvp_formed && Q.dvp_exist || Q.lvp_candidate == "Гесслер" && Q.lvp_formed) && Q.z_candidate != Q.spd_candidate && (Q.ddp_candidate != Q.spd_candidate && !Q.lvp_formed || Q.dvp_candidate != Q.spd_candidate && !Q.lvp_formed && Q.dvp_exist || Q.lvp_candidate != Q.spd_candidate && Q.lvp_exist)) {
    if (Q.Adenauer_votes > Q.Gessler_votes) {
        Q.gessler_drops_out = 1;
        if (Q.ddp_candidate != Q.spd_candidate) {
            Q.ddp_candidate = "Аденауэр";
        }
        if (Q.dvp_candidate != Q.spd_candidate) {
            Q.dvp_candidate = "Аденауэр";
        }
        if (Q.lvp_candidate != Q.spd_candidate) {
            Q.lvp_candidate = "Аденауэр";
        }
    } else {
        Q.adenauer_drops_out = 1;
        Q.z_candidate = "Гесслер";
    }
}
// DVP drops out to favor the center candidate
if (Q.dvp_candidate != Q.spd_candidate && Q.dvp_candidate != Q.ddp_candidate && Q.dvp_candidate != Q.z_candidate) {
}
!}
go-to: r2_menu

Лидирует [+ winner_desc +]. В первом туре никому не удалось набрать большинство голосов. Во втором туре победит кандидат, получивший простое большинство.

[? if gessler_drops_out : Кандидат от <span style="color: #FFCC00;">либералов</span> Отто Гесслер снял свою кандидатуру в пользу кандидата от [? if z_party_name != "ХНП": <span style="color: #000000;">Партии Центра</span> ?][? if z_party_name == "ХНП": <span style="color: #000000;">**ХНП**</span> ?] Конрада Аденауэра. Это консолидирует голоса умеренного буржуазного блока. ?] [? if adenauer_drops_out : Кандидат от[? if z_party_name != "ХНП": <span style="color: #000000;">Партии Центра</span> ?][? if z_party_name == "ХНП": <span style="color: #000000;">**ХНП**</span> ?] Конрад Аденауэр снял свою кандидатуру в пользу Отто Гесслера. Это консолидирует голоса умеренного буржуазного блока. ?]


