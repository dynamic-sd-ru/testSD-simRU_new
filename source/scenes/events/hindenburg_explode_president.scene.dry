var cand_ascii = {"Эккенер": "Eckener", "Аденауэр": "Adenauer", "Гесслер": "Gessler", "СДПГ": "SPD", "Браун": "Braun", "Брайтшайд": "Breitscheid", "Розенфельд": "Rosenfeld", "Радикалы": "Radical", "Левые": "Left", "Центр": "Center", "Труд": "Labor", "Реформисты": "Reformists", "Неоревизионисты": "Neorevisionists", "Хаммерштейн": "Hammerstein", "Гергт": "Hergt", "Осецкий": "Ossietzky", "Манн": "Mann", "Примиренцы": "Conciliators", "Гитлер": "Hitler", "Правые": "Right", "Зельдте": "Seldte", "Гинденбург": "Hindenburg", "Папен": "Papen", "КПГ": "KPD", "Гёрделер": "Goerdeler", "Вирт": "Wirth", "Умеренные": "Moderate", "Дитрих": "Dietrich", "Дингельдей": "Dingeldey", "Тревиранус": "Treviranus", "Ламбах": "Lambach", "Шиле": "Schiele", "Вестарп": "Westarp", "ННП": "DVP", "Вельс": "Wels", "Маркс": "Marx", "Штегервальд": "Stegerwald", "Каас": "Kaas", "Йоос": "Joos", "ХНП": "CVP", "Шольц": "Scholz", "НННП": "DNVP", "Гереке": "Gereke", "Лежён-Юнг": "Lejeune-Jung", "Леттов_Форбек": "Lettow-Vorbeck", "Леммер": "Lemmer", "Хойс": "Heuss", "Майер": "Maier", "Штольпер": "Stolper", "НДП": "NPD", "НГП": "DStP", "Франц Зельдте": "Franz Seldte", "Теодор Хойс": "Theodor Heuss", "Пауль фон Леттов_Форбек": "Paul von Lettow_Vorbeck", "Гугенберг": "Hugenberg", "Оскар Гергт": "Oskar Hergt", "Шумахер": "Schumacher", "Брахт": "Bracht", "Отто Штрассер": "Otto Strasser", "Фрик": "Frick", "Штрассер": "Strasser", "Бойкот": "Boycott", "Штреземан": "Stresemann", "Курциус": "Curtius", "Шлейхер": "Schleicher", "Глацель": "Glatzel", "Раумер": "Raumer", "Хуго": "Hugo", "Патерналистский консерватизм": "Paternalistic Conservatism", "фон Раумер": "von-Raumer", "Либеральный консерватизм": "Liberal Conservatism", "Национал-консерватизм": "National Conservatism", "Триумвират": "Triumvirate", "Койдель": "Keudell", "Лютер": "Luther", "Тиль": "Thiel", "Кардорф": "Kardorff", "цу Дона-Шлодин": "zu Dohna-Schlodien", "ЛНП": "LVP", "ФНЕГ": "DNEF", "НСС": "DSU", "НСДАП": "NSDAP", "Лебер": "Leber", "Виссель": "Wissell", "Зеверинг": "Severing", "Гильфердинг": "Hilferding", "Мольденхауэр": "Moldenhauer", "Райнхольд": "Reinhold", "Шмидт": "Schmidt", "Тренделенбург": "Trendelenburg", "Радбрух": "Radbruch", "Кох-Везер": "Koch-Weser", "Притвиц": "Prittwitz", "Бааде": "Baade", "Гермес": "Hermes", "Грёнер": "Groener", "Гржезинский": "Grzesinski", "Юхач": "Juchacz", "Геринг": "Goring", "Кайзер": "Kaiser", "Зект": "Seeckt", "Хельдт": "Heldt", "Дикман": "Dieckmann", "Остер": "Oster", "Выступать за назначение Папена канцлером": "Advocate for a Papen chancellorship", "Добиваться собственного переназначения": "Push for his own reappointment", "Примирить Шлейхера и Гинденбурга": "Reconcile Schleicher and Hindenburg", "Выступать за назначение Гитлера канцлером": "Advocate for a Hitler chancellorship", "Геббельс": "Goebbels", "Поддерживать общественный порядок": "Maintain public order", "Отложить выборы на неопределенный срок": "Postpone elections indefinitely", "Пауль фон Гинденбург": "Paul von Hindenburg", "Дюстерберг": "Duesterberg", "Признать поражение": "Concede defeat", "Эйнштейн": "Einstein", "антидемократические партии": "anti-democratic parties", "крайне правых": "far right", "буржуазные партии": "bourgeois parties", "левую": "left", "центристскую": "centrist", "тред-юнионистскую": "labor", "Адольф Гитлер": "Adolf Hitler", "Вильгельм Фрик": "Wilhelm Frick", "Альфред Гугенберг": "Alfred Hugenberg", "Теодор Дюстерберг": "Theodor Duesterberg", "Отто Браун": "Otto Braun", "Курт Розенфельд": "Kurt Rosenfeld", "Гуго Эккенер": "Hugo Eckener", "Конрад Аденауэр": "Konrad Adenauer", "Отто Гесслер": "Otto Gessler", "Юлиус Курциус": "Julius Curtius", "Герман Дитрих": "Hermann Dietrich", "Эдуард Дингельдей": "Eduard Dingeldey", "Пауль фон Леттов-Форбек": "Paul von Lettow-Vorbeck", "Карл Яррес": "Karl Jarres", "Ганс Лютер": "Hans Luther", "Адам Штегервальд": "Adam Stegerwald", "Куно фон Вестарп": "Kuno von Westarp", "Немецкая демократическая партия": "German Democratic Party", "Бредов": "Bredow", "Гогенцоллерн": "Hohenzollern", "Носке": "Noske", "Больц": "Bolz", "Мараун": "Mahraun", "Хельпах": "Hellpach", "Боймер": "Baumer", "Яррес": "Jarres", "Тельман": "Thalmann", "Мюнценберг": "Munzenberg", "Брюнинг": "Bruning", "Лаутенбах": "Lautenbach", "Пусто": "Empty", "Познакомиться с новым канцлером": "Become acquainted with the new chancellor", "Убедить Гинденбурга продолжать поддерживать Папена": "Convince Hindenburg to continue supporting Papen", "Дружить со Шлейхером": "Be buddies with Schleicher", "Плести интриги против Шлейхера": "Scheme against Schleicher", "Поддерживать нового канцлера": "Support the new chancellor", "Сокрушаться о потерянном": "Cry over spilt milk", "Заручиться поддержкой нацистов для своего кабинета": "Nazi backing for his cabinet", "Править в президентском правительстве": "Rule in a presidential government", "Укрепить власть": "Consolidate power", "Контролировать Папена со стороны": "Control Papen from the sidelines", "Вернуть доверие общества": "Regain public confidence", "Искать поддержку в рейхстаге": "Scavenge for parliamentary backing", "гуманитарная": "humanist", "демократическая": "democratic", "научная": "scientific", "профессиональная": "vocational", "традиционная": "traditional", "Либерал": "Liberal", "Консерватор": "Conservative", "Центрист": "Centrist"};
function candkey(n) { return cand_ascii[n] || n; }
var candidate_descs = {
Seeckt: "Hans von Seeckt, an independent formerly of the <span style='color: #C0A054; font-weight: bold;'>DVP</span>",
Эккенер: "независимый <span style='color: #000000;'>респ</span><span style='color: #DD0000;'>ублик</span><span style='color: #FFCC00;'>анский</span> кандидат Гуго Эккенер",
Аденауэр: "Konrad Adenauer of the <span style='color: #000000; font-weight: bold;'>Center Party</span>",
Гесслер: "Отто Гесслер, независимый кандидат, ранее от <span style='color: #D3C24D; font-weight: bold;'>НДП</span>",
Wels: "Otto Wels of the <span style='color: #c00000; font-weight: bold;'>SPD</span>",
Grzesinski: "Albert Grzesinski of the <span style='color: #c00000; font-weight: bold;'>SPD</span>"
}
for (var k in candidate_descs) {
    Q[candkey(k) + '_running'] = 0;
}
var candidate_votes = {};
for (var i = 0; i < Q.parties.length; i++) {
    var party = Q.parties[i];
    var supported_candidate = Q[party + '_candidate'];
    //console.log(party, supported_candidate);
    supported_candidate = supported_candidate.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    Q[candkey(supported_candidate) + '_running'] = 1;
    if (supported_candidate in candidate_votes) {
        candidate_votes[supported_candidate] += Q[party+'_normalized'];
    } else {
        candidate_votes[supported_candidate] = Q[party+'_normalized'];
    }
}
var total_votes = 0;
Q.winner = "";
Q.winner_votes = 0;
Q.has_majority = 0;
for (var k in candidate_votes) {
    if (Q[candkey(k) + '_bonus']) {
        candidate_votes[k] += Q[candkey(k) + '_bonus']/100;
    }
    total_votes += candidate_votes[k];
    if (candidate_votes[k] > Q.winner_votes) {
        Q.winner = k;
        Q.winner_votes = candidate_votes[k];
    }
    if (candidate_votes[k] >= 0.5) {
        Q.has_majority = 1;
    }
}
for (var k in candidate_votes) {
    Q[candkey(k) + '_votes'] = Math.round(1000*candidate_votes[k]/total_votes)/10;
    Q[candkey(k) + '_votes_disp'] = Q[candkey(k) + '_votes'].toFixed(1);
}
Q.winner_votes = Math.round(1000*Q.winner_votes/total_votes)/10;
Q.winner_votes_disp = Q.winner_votes.toFixed(1);
Q.winner_desc = candidate_descs[Q.winner];

if (Q.sapd_candidate == "Бойкот" || Q.kpd_candidate == "Бойкот"){
    Q.boycott_votes = 0;
    if (Q.kpd_candidate == "Бойкот") Q.boycott_votes += Q.kpd_votes;
    if (Q.sapd_candidate == "Бойкот") Q.boycott_votes += Q.sapd_votes;
}

Q.round += 1
!}
go-to: r2_start if round = 1 and not has_majority; election_end if round > 1; r1_winner if has_majority

